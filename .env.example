# Local API and database
SERVICE_NAME=stock-configurator
ENVIRONMENT=dev
LOG_LEVEL=INFO
POSTGRES_DB=stock_configurator
POSTGRES_USER=stock_app
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://stock_app:local-development-only@stock-postgres:5432/stock_configurator

# Distributor connectors are opt-in. Obtain credentials from the distributor.
OCS_BASE_URL=https://testconnector.b2b.ocs.ru
OCS_API_KEY=
OCS_SHIPMENT_CITY=Москва
TREOLAN_BASE_URL=https://demo-api.treolan.ru
TREOLAN_API_BASE_URL=https://demo-api.treolan.ru
TREOLAN_LOGIN=
TREOLAN_PASSWORD=
TREOLAN_REQUESTS_PER_MINUTE_LIMIT=30

# LLM execution is disabled until a compatible endpoint is configured.
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.7-plus
LLM_CONFIGURATOR_ENABLED=false
LLM_CONFIGURATOR_MODE=disabled
LLM_CONFIGURATOR_MAX_PACKAGE_CHARS=1500000
LLM_CONFIGURATOR_READ_TIMEOUT_SECONDS=1800
LLM_CONFIGURATOR_MAX_OUTPUT_TOKENS=65536
HIGH_QUALITY_FULL_MATRIX_BY_DEFAULT=true
STOCK_MATCH_PIPELINE_V2=true
LLM_COMPOSER_FIRST_PIPELINE=true
STOCK_MATCH_PIPELINE_V2_MODE=composer_cascade
LLM_ROLE_EVALUATION_ENABLED=false
LLM_COMPOSER_CRITIC_ENABLED=true
LLM_COMPOSER_REPAIR_MAX_ATTEMPTS=1
LLM_MAX_CALLS_PER_MATCH=6
LLM_COMPOSER_MULTI_PASS=false
V3_REFRESH_CATEGORIES_BEFORE_LLM=true
LLM_FULL_MATRIX_MAX_SECONDS=900
LLM_FULL_MATRIX_CHUNK_TIMEOUT_SECONDS=300
LLM_SEMANTIC_PLANNER_MAX_SECONDS=300
LLM_SEMANTIC_PLANNER_STAGE_TIMEOUT_SECONDS=120
LLM_FULL_MATRIX_FORCE=false
LLM_CONFIGURATOR_NO_RECOMMENDATION_MIN_LARGE_ROLE_CANDIDATES=12
WEB_EVIDENCE_ENABLED=false
WEB_EVIDENCE_PROVIDER=disabled
WEB_EVIDENCE_BASE_URL=
WEB_EVIDENCE_API_KEY=
TAVILY_API_KEY=

# Optional Telegram profile
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_PROXY_URL=
STOCK_API_BASE_URL=http://stock-api:8000
TELEGRAM_V3_REQUEST_TIMEOUT_SECONDS=1800
