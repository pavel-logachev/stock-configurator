# Local API and database
SERVICE_NAME=stock-configurator
ENVIRONMENT=dev
LOG_LEVEL=INFO
POSTGRES_DB=stock_configurator
POSTGRES_USER=stock_app
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://stock_app:local-development-only@stock-postgres:5432/stock_configurator

# Distributor connectors are opt-in. Obtain credentials from the distributor.
OCS_BASE_URL=https://testconnector.b2b.ocs.ru
OCS_API_BASE_URL=https://testconnector.b2b.ocs.ru
OCS_API_KEY=
OCS_SHIPMENT_CITY=Москва
OCS_TIMEOUT_SECONDS=30
OCS_REQUEST_TIMEOUT_SECONDS=30
OCS_REQUEST_DELAY_SECONDS=0
OCS_REQUESTS_PER_HOUR_LIMIT=180
OCS_CONTENT_ENABLED=true
OCS_CONTENT_BATCH_SIZE=50
OCS_CONTENT_MAX_ITEMS_PER_RUN=120
OCS_CONTENT_CACHE_TTL_HOURS=168
TREOLAN_BASE_URL=https://demo-api.treolan.ru
TREOLAN_API_BASE_URL=https://demo-api.treolan.ru
TREOLAN_LOGIN=
TREOLAN_PASSWORD=
TREOLAN_SHIPMENT_CITY=Treolan
TREOLAN_TIMEOUT_SECONDS=30
TREOLAN_REQUEST_TIMEOUT_SECONDS=30
TREOLAN_REQUEST_DELAY_SECONDS=0
TREOLAN_REQUESTS_PER_MINUTE_LIMIT=30
TREOLAN_CATALOG_CRITERION=1
TREOLAN_CATALOG_SHOW_NC=1
TREOLAN_CATALOG_FREE_NOM_ONLY=true

# LLM execution is disabled until a compatible endpoint is configured.
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.7-plus
LLM_TIMEOUT_SECONDS=60
LLM_CONFIGURATOR_ENABLED=false
LLM_CONFIGURATOR_MODE=disabled
LLM_CONFIGURATOR_OUTPUT_MODE=single_best_cost_valid
LLM_COMPONENT_CANDIDATES_PER_ROLE=100
LLM_CONFIGURATOR_MAX_PACKAGE_CHARS=1500000
LLM_BUILD_RECOMMENDATIONS_LIMIT=5
LLM_PROPOSAL_POOL_LIMIT=10
LLM_CONFIGURATOR_TIMEOUT_SECONDS=60
LLM_CONFIGURATOR_READ_TIMEOUT_SECONDS=1800
LLM_CONFIGURATOR_MAX_OUTPUT_TOKENS=65536
HIGH_QUALITY_FULL_MATRIX_BY_DEFAULT=true
STOCK_MATCH_PIPELINE_V2=true
LLM_COMPOSER_FIRST_PIPELINE=true
STOCK_MATCH_PIPELINE_V2_MODE=composer_cascade
LLM_ROLE_EVALUATION_ENABLED=false
LLM_COMPOSER_CRITIC_ENABLED=true
LLM_COMPOSER_REPAIR_MAX_ATTEMPTS=1
LLM_MAX_CALLS_PER_MATCH=6
LLM_COMPOSER_MULTI_PASS=false
LLM_COMPOSER_MULTI_PASS_CANDIDATE_THRESHOLD=120
LLM_COMPOSER_MULTI_PASS_CHUNK_SIZE=80
LLM_CONFIGURATOR_REPAIR_ENABLED=true
LLM_CONFIGURATOR_REPAIR_MAX_ALTERNATIVES_PER_ROLE=5
LLM_CONFIGURATOR_REPAIR_TIMEOUT_SECONDS=300
LLM_CONFIGURATOR_THINKING_ENABLED=false
LLM_CONFIGURATOR_THINKING_BUDGET_TOKENS=
V3_REFRESH_CATEGORIES_BEFORE_LLM=true
V3_FULL_CATEGORY_CONTRACT_VERSION=v7_1
LLM_FULL_MATRIX_MAX_SECONDS=900
LLM_FULL_MATRIX_CHUNK_TIMEOUT_SECONDS=300
LLM_SEMANTIC_PLANNER_MAX_SECONDS=300
LLM_SEMANTIC_PLANNER_STAGE_TIMEOUT_SECONDS=120
LLM_FULL_MATRIX_FORCE=false
LLM_CONFIGURATOR_NO_RECOMMENDATION_FULL_COVERAGE_LIMIT=12
LLM_CONFIGURATOR_NO_RECOMMENDATION_MIN_LARGE_ROLE_CANDIDATES=12
LLM_CONFIGURATOR_NO_RECOMMENDATION_MIN_LARGE_ROLE_FRACTION=0.5
WEB_EVIDENCE_ENABLED=false
WEB_EVIDENCE_PROVIDER=disabled
WEB_EVIDENCE_MODE=separate
WEB_EVIDENCE_BASE_URL=
WEB_EVIDENCE_API_KEY=
WEB_EVIDENCE_MODEL=deepseek/deepseek-v4-pro:online
WEB_EVIDENCE_MAX_OUTPUT_TOKENS=4096
WEB_EVIDENCE_MAX_QUERIES=12
WEB_EVIDENCE_TIMEOUT_SECONDS=120
WEB_EVIDENCE_CACHE_TTL_HOURS=168
WEB_EVIDENCE_MAX_RESULTS_PER_QUERY=5
WEB_EVIDENCE_MAX_SNIPPET_CHARS=1200
WEB_EVIDENCE_TRUSTED_DOMAINS=dell.com,i.dell.com,hpe.com,lenovo.com,asus.com,servers.asus.com,supermicro.com,intel.com,ark.intel.com,amd.com,kioxia.com,samsung.com,semiconductor.samsung.com,micron.com,gooxi.com
TAVILY_API_KEY=

# Optional Telegram profile
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_PROXY_URL=
STOCK_API_BASE_URL=http://stock-api:8000
TELEGRAM_REQUEST_TIMEOUT_SECONDS=60
TELEGRAM_V3_REQUEST_TIMEOUT_SECONDS=1800
